{{> header showMenu=true}}

<div class="container mt-5 cookly-home">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">


            <div class="cookly-welcome text-start p-4 rounded-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i data-lucide="chef-hat" class="cookly-welcome-icon"></i>
                    <span class="small fw-semibold text-uppercase">
                        Your Kitchen
                    </span>
                </div>

                <h2 class="fw-bold mb-2">
                    Welcome back, {{username}}!
                </h2>

                <p class="mb-3">
                    Find something delicious to make with ingredients you already have.
                </p>

                <a href="/recipes" class="btn btn-success">
                    <i data-lucide="book-open" class="me-1"></i>
                    Explore Recipes
                </a>
            </div>




            <!-- Kitchen Dashboard Cards -->
            <div class="row g-4 mt-2">

                <!-- My Pantry -->
                <div class="col-md-6">
                    <div class="card cookly-dashboard-card h-100">
                        <div class="card-body text-start p-4">

                            <i data-lucide="carrot" class="cookly-card-icon mb-3"></i>

                            <h4 class="card-title">My Pantry</h4>

                            <p class="card-text text-muted">
                                Add and manage the ingredients you have in your kitchen.
                            </p>

                            <a href="/pantry" class="btn btn-success">
                                Go to My Pantry
                            </a>

                        </div>
                    </div>
                </div>

                <!-- Future Recipe Matching -->
                <div class="col-md-6">
                    <div class="card cookly-dashboard-card h-100">
                        <div class="card-body text-start p-4">

                            <div class="d-flex justify-content-between align-items-start">
                                <i data-lucide="utensils" class="cookly-card-icon mb-3"></i>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>

                            <h4 class="card-title">Cook With What You Have</h4>

                            <p class="card-text text-muted">
                                Discover recipes based on ingredients in your pantry.
                            </p>

                        </div>
                    </div>
                </div>

            </div>


        </div>
    </div>
</div>

{{> footer}}