{{> header showMenu=true}}

<div class="container mt-5 cookly-home">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <h2 class="mb-3" style="color: #27372b;">
                Welcome to Cookly, {{username}}!
            </h2>



            <p class="text-muted mb-4">
                Find recipes using ingredients you already have at home.
            </p>


            <div class="card mt-4">
                <div class="card-body">
                    <h4 class="card-title">Discover Recipes</h4>
                    <p class="card-text text-muted">
                        Explore recipes and find something new to cook.
                    </p>
                    <a href="/recipes" class="btn btn-success">
                        Browse Recipes
                    </a>
                </div>
            </div>


            <div class="card mt-4">
                <div class="card-body">
                    <h4 class="card-title">My Ingredients</h4>
                    <p class="card-text text-muted">
                        Keep track of the ingredients you have at home.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{{> footer}}