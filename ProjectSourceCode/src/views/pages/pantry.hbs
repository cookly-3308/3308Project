
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Pantry - Cookly</title>
  <link rel="stylesheet" href="/css/pantry.css">
</head>

<body>
  <div class="pantry-layout">

    <!-- Sidebar -->
    <aside class="pantry-sidebar">
      <h1>Cookly</h1>
      <p>YOUR KITCHEN</p>

      <nav>
        <a href="/home">Home</a>
        <a href="/pantry" class="active">My Pantry</a>
        <a href="/recipes">Browse Recipes</a>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="pantry-main">

      <header class="pantry-header">
        <p class="pantry-label">YOUR KITCHEN</p>
        <h1>My Pantry</h1>
        <p>Manage the ingredients you already have at home.</p>
      </header>

      <!-- Saved Ingredients -->
      <section class="pantry-section">

        <div class="pantry-section-header">
          <h2>Saved Ingredients</h2>
          <button
            class="pantry-add-button"
            type="button"
            id="show-add-form"
            aria-controls="add-ingredient-form"
            aria-expanded="false"
          >
          + Add Manually
        </button>
        </div>

      <!-- Add Ingredient Form -->
      <form id="add-ingredient-form" class="pantry-add-form" hidden>

        <h3>Add Ingredient</h3>

          <label for="ingredient-name">Ingredient Name</label>
          <input
            type="text"
            id="ingredient-name"
            placeholder="e.g. Carrots"
          required
          >

        <label for="ingredient-quantity">Quantity</label>
        <input
          type="number"
          id="ingredient-quantity"
          min="0.01"
          step="any"
          value="1"
          required
        >

        <label for="ingredient-unit">Unit</label>
        <select id="ingredient-unit">
          <option value="pieces">Pieces</option>
          <option value="cups">Cups</option>
          <option value="pounds">Pounds</option>
          <option value="gallons">Gallons</option>
          <option value="ounces">Ounces</option>
      </select>

  <div class="pantry-form-actions">
    <button type="button" id="cancel-add-ingredient">
      Cancel
    </button>
    <button type="submit" class="pantry-save-button">
      Save Ingredient
    </button>
  </div>

</form>


        <div class="pantry-ingredients">

          {{#each ingredients}}
            <div class="pantry-ingredient-card">
              <h3>{{this.name}}</h3>
              <p>{{this.quantity}} {{this.unit}}</p>
            </div>
          {{else}}
            <p class="pantry-empty">
              No ingredients added yet.
            </p>
          {{/each}}

        </div>

      </section>

    </main>
  </div>
  <script src="/js/pantry.js" defer></script>
</body>
</html>
