{{> header showMenu=true}}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold">Browse Recipes</h1>
            <p class="text-muted mb-0">Discover meals you can make with your ingredients.</p>
        </div>

        <form action="/recipes" method="GET" class="d-flex gap-2">
            <input type="text" name="q" value="{{search}}" class="form-control" placeholder="Search recipes">
            <button type="submit" class="btn btn-success">Search</button>
        </form>
    </div>

    <div class="row g-4">
        {{#each recipes}}
        <div class="col-md-6 col-lg-4">
            <div class="card cookly-dashboard-card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text text-muted">{{this.description}}</p>
                    <p class="small mb-3">Prep {{this.prep_time}} min · Cook {{this.cook_time}} min</p>
                    <a href="/recipes/{{this.recipe_id}}" class="btn btn-success mt-auto">View Recipe</a>
                </div>
            </div>
        </div>
        {{else}}
        <p class="text-muted">No recipes found.</p>
        {{/each}}
    </div>

</div>

{{> footer}}
