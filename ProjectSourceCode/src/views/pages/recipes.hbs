
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Browse Recipes - Cookly</title>
    <link rel="stylesheet" href="/css/recipes.css">
</head>

<body>
    <div class="recipe-layout">

        <!-- Sidebar -->
        <aside class="recipe-sidebar">
            <h1>Cookly</h1>
            <p>YOUR KITCHEN</p>

            <nav>
                <a href="/home">Home</a>
                <a href="/pantry">My Pantry</a>
                <a href="/recipes" class="active">
                    Browse Recipes
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="recipe-main">

            <!-- Page Header -->
            <header class="recipe-header">
                <p class="recipe-label">YOUR KITCHEN</p>
                <h1>Browse Recipes</h1>
                <p>
                    Discover delicious meals you can make
                    with ingredients you already have.
                </p>
            </header>

            <!-- Recipe Section -->
            <section class="recipe-section">

                <div class="recipe-section-header">
                    <div>
                        <h2>Available Recipes</h2>
                        <p>
                            Explore recipes and find your
                            next meal.
                        </p>
                    </div>

                    <span class="recipe-count">
                        {{recipes.length}} Recipes
                    </span>
                </div>

                <!-- Recipe Cards -->
                <div class="recipe-grid">

                    {{#each recipes}}
                    <article class="recipe-card">

                        <div class="recipe-card-image">
                            <span>Cookly Recipe</span>
                        </div>

                        <div class="recipe-card-content">

                            <h3>{{this.name}}</h3>

                            <p class="recipe-description">
                                {{this.description}}
                            </p>

                            <div class="recipe-info">
                                <span>
                                    Prep: {{this.prep_time}} min
                                </span>

                                <span>
                                    Cook: {{this.cook_time}} min
                                </span>
                            </div>

                            <a href="/recipes/{{this.recipe_id}}"
                               class="recipe-view-button">
                                View Recipe
                            </a>

                        </div>

                    </article>
                    {{else}}
                    <div class="recipe-empty">
                        <h3>No recipes available</h3>
                        <p>
                            Recipes will appear here once
                            they have been added.
                        </p>
                    </div>
                    {{/each}}

                </div>

            </section>

        </main>

    </div>
</body>
</html>
